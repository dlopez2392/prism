# Prism (apps/finance) — copy to .env.local. Every value is server-only.
# Leave the Plaid pair blank to run on the demo household.

# Plaid keys from dashboard.plaid.com (sandbox keys are free).
PLAID_CLIENT_ID=
PLAID_SECRET=
# "sandbox" (default) or "production".
PLAID_ENV=sandbox
# Optional: where banks that sign people in on their own website send them back
# to on phones — exactly https://<host>/connections/return, set only AFTER adding
# it to Plaid's Allowed redirect URIs (Plaid refuses Link otherwise). Locally,
# in the sandbox: http://localhost:3100/connections/return.
PLAID_REDIRECT_URI=
# Optional: where Plaid announces new transactions. Defaults to this site's
# https://<host>/api/plaid/webhook (webhooks need HTTPS, so none from localhost).
PLAID_WEBHOOK_URL=
# TEST ONLY, sandbox only: point the Plaid client at a fake Plaid. Ignored in production.
PLAID_API_URL=
# "on" reads each card's and loan's due date, minimum, statement balance and rate
# (Plaid Liabilities) at most daily, for banks holding a card or loan. Plaid BILLS
# it per bank from the first read, so it's off unless set; turning it on also
# changes the privacy policy's wording, in the same deploy.
PLAID_LIABILITIES=

# RentCast API key (https://app.rentcast.io/app/api): switches on "Keep its value
# up to date with RentCast" for homes on Net worth. RentCast BILLS each request
# past the plan's allowance; the database caps lookups (app_limits, 45 in any 31
# days to start) whatever the app does. Setting it also adds RentCast to the
# privacy policy, in the same deploy. Mark it Sensitive in Vercel.
RENTCAST_API_KEY=
# TEST ONLY: point the RentCast client at a fake server.
RENTCAST_API_URL=

# Alchemy API key (https://dashboard.alchemy.com, free tier): switches on Ethereum
# and Solana wallets by public address. Bitcoin wallets need no key (mempool.space).
# Setting it also adds Alchemy to the privacy policy, in the same deploy. Sensitive.
ALCHEMY_API_KEY=

# 32 random bytes, base64 (openssl rand -base64 32). Seals linked-bank tokens.
# Required when PLAID_ENV=production; the sandbox falls back to a key derived
# from PLAID_SECRET so a first link works with two variables.
# In Vercel: Production ONLY, marked Sensitive. Never Preview, which builds
# unmerged code (the app refuses a key on a preview anyway).
PRISM_VAULT_KEY=
# Replacing it: ADD the next number (PRISM_VAULT_KEY_2, then _3, up to _99)
# and keep the old one until nothing is left under it (README, "Replacing the
# vault key"). The highest number seals; every number opens.

# Coinbase read-only link (Coinbase Developer Platform → OAuth client). Leave
# blank to hide "Connect Coinbase". Needs PRISM_VAULT_KEY (or the Plaid
# sandbox fallback) to seal its tokens. Register the redirect URI exactly:
# https://<your-domain>/api/coinbase/callback
COINBASE_CLIENT_ID=
COINBASE_CLIENT_SECRET=
# Optional: set when the registered redirect differs from <origin>/api/coinbase/callback.
COINBASE_REDIRECT_URI=

# Prism accounts (Supabase). Leave blank to keep everything on the device.
# Project Settings → API: the project URL and the publishable (anon) key.
# Safe in the browser: row-level security is what guards each person's data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
