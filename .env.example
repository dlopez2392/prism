# Prism (apps/finance) — copy to .env.local. Every value is server-only.
# Leave the Plaid pair blank to run on the demo household.

# Plaid keys from dashboard.plaid.com (sandbox keys are free).
PLAID_CLIENT_ID=
PLAID_SECRET=
# "sandbox" (default) or "production".
PLAID_ENV=sandbox
# Optional: required for OAuth banks in production; register it in the Plaid dashboard.
PLAID_REDIRECT_URI=
# Optional: where Plaid sends SYNC_UPDATES_AVAILABLE.
PLAID_WEBHOOK_URL=

# 32 random bytes, base64 (openssl rand -base64 32). Seals linked-bank tokens.
# Required when PLAID_ENV=production; the sandbox falls back to a key derived
# from PLAID_SECRET so a first link works with two variables.
PRISM_VAULT_KEY=

# Coinbase read-only link (Coinbase Developer Platform → OAuth client). Leave
# blank to hide "Connect Coinbase". Needs PRISM_VAULT_KEY (or the Plaid
# sandbox fallback) to seal its tokens. Register the redirect URI exactly:
# https://<your-domain>/api/coinbase/callback
COINBASE_CLIENT_ID=
COINBASE_CLIENT_SECRET=
# Optional: set when the registered redirect differs from <origin>/api/coinbase/callback.
COINBASE_REDIRECT_URI=
